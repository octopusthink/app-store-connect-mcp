{
  "name": "@octopusthink/app-store-connect-mcp",
  "version": "0.1.1",
  "description": "MCP server for Apple's App Store Connect API: apps, metadata, TestFlight, reviews, reports, Xcode Cloud and more.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "app-store-connect",
    "apple",
    "testflight",
    "claude"
  ],
  "license": "MIT",
  "author": "Octopus Think",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/octopusthink/app-store-connect-mcp.git"
  },
  "type": "module",
  "bin": {
    "app-store-connect-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "node --watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "update-spec": "node scripts/update-spec.ts",
    "inspect": "npm run build && npx -y @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
